{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing Skill Contract v1.6",
  "type": "object",
  "required": ["version", "requirements"],
  "properties": {
    "version": {"const": "1.6"},
    "requirements": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "obligation", "value", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][\\w.-]*$"},
        "obligation": {"enum": ["must", "must_not", "should", "may"]},
        "value": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
