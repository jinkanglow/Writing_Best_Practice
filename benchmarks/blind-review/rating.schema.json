{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Blind editorial paired rating",
  "type":"object",
  "additionalProperties":false,
  "required":["caseId","reviewerId","blindArm","genre","scores","observations"],
  "properties":{
    "caseId":{"type":"string","minLength":1},
    "reviewerId":{"type":"string","minLength":1},
    "blindArm":{"enum":["A","B"]},
    "genre":{"type":"string","minLength":1},
    "scores":{"type":"object","additionalProperties":false,"required":["factualFidelity","causalClarity","specificity","voicePreservation"],"properties":{"factualFidelity":{"type":"integer","minimum":1,"maximum":5},"causalClarity":{"type":"integer","minimum":1,"maximum":5},"specificity":{"type":"integer","minimum":1,"maximum":5},"voicePreservation":{"type":"integer","minimum":1,"maximum":5}}},
    "observations":{"type":"array","minItems":1,"items":{"type":"object","required":["passage","reason"],"properties":{"passage":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1},"evidenceRef":{"type":"string"}}}}
  }
}
